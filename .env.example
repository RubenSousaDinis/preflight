# Preflight — per-chain configuration surface (tasks/02-DECISIONS.md §3 and §13.6)
# No default network. Every chain this project touches is configured explicitly.

# Base mainnet (chainId 8453) — validator attestations, txGuard's unseen-run fork (D4)
BASE_MAINNET_RPC_URL=
BASE_MAINNET_EXPLORER_API_KEY=

# Base Sepolia (chainId 84532) — staged fixtures (D3) and txGuard's staged fork (B5a)
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_EXPLORER_API_KEY=

# Hedera Testnet — the payment rail (B3, D2), HBAR settlement, ECDSA payer account
HEDERA_TESTNET_RPC_URL=
HEDERA_TESTNET_ACCOUNT_ID=
HEDERA_TESTNET_PRIVATE_KEY=

# Which rail a run from the console settles on: stub, hedera-transfer, or hedera-x402.
# Absent means stub, and that default is deliberate: once a settling rail is selected the Run
# button moves funds on every click, so selecting one is the operator's explicit act. Setting
# hedera-transfer also needs the two variables above plus the payee below, and the run route
# refuses the request rather than falling back to the stub if any of them is missing.
# hedera-x402 is refused: no endpoint here issues a 402 challenge yet.
PREFLIGHT_DEMO_RAIL=
# The hired agent's own Hedera account, so a settled fee lands with the agent rather than back
# with the client. Also the default --pay-to for the demo CLI.
A_AGENT_HEDERA_ACCOUNT_ID=

# Evidence pinning — 0G Storage primary (A3b)
ZEROG_STORAGE_PRIVATE_KEY=
ZEROG_COMPUTE_ROUTER_API_KEY=
# The router speaks the OpenAI chat-completions shape. Model ids: GET {base}/models
ZEROG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
ZEROG_COMPUTE_MODEL=0gm-1.0-35b-a3b

# Validator identity — fresh ECDSA keypair generated at the event, Ruben-only custody
VALIDATOR_PRIVATE_KEY=

# ENS grade mirror (D5b, D5d), optional. Text records under a validator-owned parent name carry
# the grade the ValidationRegistry already holds. They are a mirror and never a source, so leaving
# all of this unset costs nothing: no mirror runs and every surface reads the registry as before.
# The first three are all-or-nothing. A partial set throws rather than guessing a target.
# Writes are Base Sepolia only (ENS_CHAIN_ID=84532); any other chain is refused at send time.
# Event parent: preflight.basetest.eth (Basenames testnet TLD is basetest.eth, not base.eth).
ENS_CHAIN_ID=
ENS_REGISTRY_ADDRESS=
ENS_PARENT_NAME=
# Optional. Absent means new subnames inherit the resolver the parent name already has.
ENS_RESOLVER_ADDRESS=
# Optional. Absent means the configured endpoint for ENS_CHAIN_ID.
ENS_RPC_URL=

# Which agents the leaderboard lists when the URL does not say. Absent falls through
# to the four demo agents D1 registered (8427, 8430, 8436, 8437). An empty
# ?agents= still lists nobody.
# Id range probed for ENS-mirrored agents on the grade form (inclusive, max 200 wide).
PREFLIGHT_DISCOVER_FROM=8420
PREFLIGHT_DISCOVER_TO=8450

PREFLIGHT_BOARD_AGENT_IDS=

# Public app origin for ENS url text records (optional; defaults to Vercel / preflight-bay)
PREFLIGHT_PUBLIC_URL=

# Set to 1 to allow mainnet-row ENS claims (registers a Sepolia mirror with the
# validator key). Leave unset on public deployments; operator machines only.
PREFLIGHT_ALLOW_MAINNET_CLAIM=
