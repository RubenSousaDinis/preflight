# Preflight — per-chain configuration surface (tasks/02-DECISIONS.md §3 and §13.6)
# No default network. Every chain this project touches is configured explicitly.

# Base mainnet (chainId 8453) — validator attestations, txGuard's unseen-run fork (D4)
BASE_MAINNET_RPC_URL=
BASE_MAINNET_EXPLORER_API_KEY=

# Base Sepolia (chainId 84532) — staged fixtures (D3) and txGuard's staged fork (B5a)
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_EXPLORER_API_KEY=

# Hedera Testnet — the x402 payment rail (B3, D2), HBAR settlement, ECDSA payer account
HEDERA_TESTNET_RPC_URL=
HEDERA_TESTNET_ACCOUNT_ID=
HEDERA_TESTNET_PRIVATE_KEY=

# Evidence pinning — 0G Storage primary (A3b)
ZEROG_STORAGE_PRIVATE_KEY=
ZEROG_COMPUTE_ROUTER_API_KEY=

# Validator identity — fresh ECDSA keypair generated at the event, Ruben-only custody
VALIDATOR_PRIVATE_KEY=
